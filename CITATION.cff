    family-names: Erfanian
  - given-names: Sahith
    family-names: Battula
repository-code: "https://github.com/letuseatlettuce/GRACE-LoRA"
license: MIT
date-released: "2026-10-23"
keywords:
  - machine-learned interatomic potentials
  - GRACE
  - LoRA
  - fine-tuning
  - organic molecules
  - agents
